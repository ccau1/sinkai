# ── Server Connection ──────────────────────────────────────────
HOST=your-server-ip
USER=root
SSH_KEY=~/.ssh/id_ed25519

# ── Environment ────────────────────────────────────────────────
# Options: dev, staging, prod
ENV=staging

# ── Docker Image ───────────────────────────────────────────────
APP_IMAGE=ghcr.io/your-org/your-repo:staging

# Optional: GitHub Container Registry login for private images
GHCR_USER=
GHCR_TOKEN=

# ── Project Name ───────────────────────────────────────────────
# Defaults to the parent directory name. Used for the remote path:
#   /opt/${PROJECT_NAME}-${ENV}
# PROJECT_NAME=my-app

# ── Health Check ───────────────────────────────────────────────
# If set, deploy.sh will poll this URL after deployment
# HEALTH_URL=https://my-app.staging.example.com

# ── Let's Encrypt / Traefik ────────────────────────────────────
# Used by setup-server.sh when installing Traefik
ACME_EMAIL=admin@example.com
