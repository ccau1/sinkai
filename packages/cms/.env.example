# Payload secret — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Payload log level (trace, debug, info, warn, error)
PAYLOAD_LOG_LEVEL=info

# Local dev database (falls back to D1 binding on Cloudflare)
DATABASE_URI=file:./payload.sqlite

# Cloudflare credentials for wrangler / D1 / R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: environment for multi-env wrangler commands (e.g. production)
CLOUDFLARE_ENV=

# Public media domain serving R2 originals/thumbnails (a wrangler var in
# deployed environments; set here for local dev). When unset, media URLs fall
# back to being served through the CMS.
MEDIA_PUBLIC_URL=https://sinkai-cms-media.staging.tribalorigin.com

# Public web app URL used to build shareable form links shown in the CMS admin.
# No trailing slash, e.g. https://sinkai.tribalorigin.com
WEB_APP_URL=https://sinkai.tribalorigin.com

# Resend email integration for contact form notifications
# Set via `wrangler secret put RESEND_API_KEY` for staging / production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=contact@sinkai.org
CONTACT_EMAIL_TO=calvin@tribalorigin.com

# On-demand ISR revalidation of the web site. When set, content changes POST
# to {WEB_APP_URL}/api/revalidate (see src/hooks/triggerWebRevalidate.ts).
# Set via `wrangler secret put REVALIDATE_SECRET` in deployed environments;
# must match the secret on the web worker. Leave empty to disable (local dev).
REVALIDATE_SECRET=

# Optional: OpenAI API key for AI-powered localization
OPENAI_API_KEY=

# Wrangler proxy behaviour for scripts / local dev
PAYLOAD_REMOTE=false
PAYLOAD_PERSIST=true

# Script flag: set to true for dry-run cleanup/migration scripts
DRY_RUN=false

# Skip on-demand ISR revalidation during bulk operations (e.g. seed scripts).
# This avoids flooding the web app's /api/revalidate endpoint and console noise.
SKIP_WEB_REVALIDATE=false
