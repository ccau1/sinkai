{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "sinkai-cms-staging",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public",
  ],
  "minify": true,
  "keep_names": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Give the Payload admin SSR more headroom on cold starts so that heavier
  // list/edit views don't hit Cloudflare's Worker CPU limit (Error 1102).
  "limits": {
    "cpu_ms": 120000,
    "subrequests": 10000,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "routes": [
    {
      "pattern": "sinkai-cms.staging.tribalorigin.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "f8fdf96e-eeff-4118-a6eb-a0311c15723e",
      "database_name": "sinkai-cms-staging",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "sinkai-cms-media-staging",
    },
  ],
  "services": [
    {
      "binding": "THUMBNAILS",
      "service": "sinkai-cms-thumbnails-staging",
    },
  ],
  "vars": {
    "RESEND_FROM_EMAIL": "contact@sinkai.org",
    "CONTACT_EMAIL_TO": "calvin@tribalorigin.com",
    "MEDIA_PUBLIC_URL": "https://sinkai-cms-media.staging.tribalorigin.com",
    "WEB_APP_URL": "https://sinkai.staging.tribalorigin.com",
  },
  "env": {
    "production": {
      "name": "sinkai-cms-prod",
      "limits": {
        "cpu_ms": 120000,
        "subrequests": 10000,
      },
      "routes": [
        {
          "pattern": "sinkai-cms.tribalorigin.com",
          "custom_domain": true,
        },
      ],
      "d1_databases": [
        {
          "binding": "D1",
          "database_id": "8c6943d9-ad8f-438b-9a19-a4d2af0e652d",
          "database_name": "sinkai-cms-prod",
          "remote": true,
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "sinkai-cms-media-prod",
        },
      ],
      "services": [
        {
          "binding": "THUMBNAILS",
          "service": "sinkai-cms-thumbnails-prod",
        },
      ],
      "vars": {
        "RESEND_FROM_EMAIL": "contact@sinkai.org",
        "CONTACT_EMAIL_TO": "calvin@tribalorigin.com",
        "MEDIA_PUBLIC_URL": "https://sinkai-cms-media.tribalorigin.com",
        "WEB_APP_URL": "https://sinkai.tribalorigin.com",
      },
    },
  },
}
