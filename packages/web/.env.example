# CMS API URL — required for the static export (build-time data fetching) and
# the contact form. Should point to the CMS origin.
CMS_API_URL=http://localhost:3001

# Optional public fallback for the CMS API. Used by client-side image transform
# logic when CMS_API_URL is not available in the browser.
NEXT_PUBLIC_CMS_API_URL=

# Cloudflare Images on-the-fly transforms.
# Set to true in staging/production where the media domain is behind Cloudflare.
NEXT_PUBLIC_ENABLE_IMAGE_TRANSFORMS=false

# Origin used for Cloudflare Image Resizing URLs (/cdn-cgi/image/...).
# Defaults to CMS_API_URL if unset. Use the public media host in production.
NEXT_PUBLIC_CMS_IMAGE_TRANSFORM_ORIGIN=https://sinkai-cms-media.staging.tribalorigin.com

# Future R2 image proxy worker.
# When set, CmsImage will request images through the proxy instead of
# /cdn-cgi/image/. Leave empty until the proxy worker is deployed.
NEXT_PUBLIC_IMAGE_PROXY_ORIGIN=
